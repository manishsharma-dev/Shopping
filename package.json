{
  "name": "shopping-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "backend:dev": "npm --prefix apps/backend run start:dev",
    "admin:dev": "npm --prefix apps/admin run start -- --host 0.0.0.0 --port 4200",
    "shop:dev": "npm --prefix apps/shop run start -- --host 0.0.0.0 --port 4300",
    "backend:build": "npm --prefix apps/backend run build",
    "admin:build": "npm --prefix apps/admin run build",
    "shop:build": "npm --prefix apps/shop run build"
  }
}
