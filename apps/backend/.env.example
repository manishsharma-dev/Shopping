PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=shopping_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Comma-separated browser origins allowed to use authentication
AUTH_ORIGINS=http://localhost:4200,http://localhost:4300

# Explicit local-only superadmin seed; set a unique password in .env
SEED_SUPERADMIN_EMAIL=superadmin@shopping.local
SEED_SUPERADMIN_PASSWORD=
